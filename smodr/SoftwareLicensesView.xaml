<UserControl
    x:Class="smodr.SoftwareLicensesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Height="480" MaxHeight="540">
        <StackPanel x:Name="LoadingState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing x:Name="LoadingRing" IsActive="True" AutomationProperties.Name="Loading software licenses" />
            <TextBlock Text="Loading software licenses…" TextWrapping="Wrap" />
        </StackPanel>
        <!-- Keep the built-in scroll host and a bounded viewport for UI virtualization. -->
        <ListView x:Name="NoticesList" Visibility="Collapsed" SelectionMode="None"
                  AutomationProperties.Name="Software license notices">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
