<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="smodr.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:smodr"
        xmlns:models="using:smodr.Models"
        xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
        Title="Shoutkit">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE720;" FontSize="16" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Shoutkit" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}"/>
        </Grid>
        <NavigationView x:Name="AppNavigation" Grid.Row="1" PaneDisplayMode="Auto"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                        OpenPaneLength="220" CompactPaneLength="48"
                        SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ListenNowItem" Content="Listen Now" Tag="listen">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SearchItem" Content="Search" Tag="search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="ListenNowView">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="28,20,28,32" Spacing="24">
                            <Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Listen Now" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                                    <TextBlock Text="Live radio picked for right now" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Click="RefreshButton_Click"
                                        ToolTipService.ToolTip="Refresh stations" AutomationProperties.Name="Refresh stations"><FontIcon Glyph="&#xE72C;"/></Button>
                            </Grid>
                            <StackPanel x:Name="RecentSection" Spacing="12" Visibility="Collapsed">
                                <TextBlock Text="Recently Played" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Recents, Mode=OneWay}" SelectionMode="None" AutomationProperties.Name="Recently played stations"
                                          ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                          ScrollViewer.VerticalScrollMode="Disabled">
                                    <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RadioStation">
                                            <Button Width="164" Padding="0" Margin="0,0,14,0" Background="Transparent" BorderThickness="0"
                                                    Tag="{x:Bind}" Click="StationButton_Click" AutomationProperties.Name="{x:Bind Name}">
                                                <Button.ContextFlyout>
                                                    <MenuFlyout><MenuFlyoutItem Text="Toggle Favorite" Tag="{x:Bind}" Click="StationFavoriteMenuItem_Click"/></MenuFlyout>
                                                </Button.ContextFlyout>
                                                <StackPanel Width="164" Spacing="8">
                                                    <Border Width="164" Height="164" CornerRadius="18" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <local:StationArtworkControl ArtworkUrl="{x:Bind ArtworkUrl}"/>
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Popular Stations" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <GridView ItemsSource="{x:Bind ViewModel.PopularStations, Mode=OneWay}" AutomationProperties.Name="Popular stations"
                                          IsItemClickEnabled="True" ItemClick="StationGrid_ItemClick" SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RadioStation">
                                            <Grid Width="180" Margin="4,4,12,18" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout><MenuFlyoutItem Text="Toggle Favorite" Tag="{x:Bind}" Click="StationFavoriteMenuItem_Click"/></MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.RowDefinitions><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border CornerRadius="20" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <local:StationArtworkControl ArtworkUrl="{x:Bind ArtworkUrl}"/>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="2" Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="SearchView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Padding="28,20,28,12" Spacing="4">
                        <TextBlock Text="Search" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock Text="Stations and genres" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Padding="28,4,28,16" Spacing="14">
                        <AutoSuggestBox x:Name="StationSearchBox" PlaceholderText="Stations, genres" QueryIcon="Find" AutomationProperties.Name="Search stations"
                                        QuerySubmitted="StationSearchBox_QuerySubmitted"/>
                        <StackPanel x:Name="GenreSection" Spacing="10">
                            <TextBlock Text="Browse by Genre" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <ItemsControl>
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <Button Content="Alternative" Tag="alternative" Click="GenreButton_Click" Margin="0,0,8,8"/>
                                <Button Content="Classical" Tag="classical" Click="GenreButton_Click" Margin="0,0,8,8"/>
                                <Button Content="Electronic" Tag="electronic" Click="GenreButton_Click" Margin="0,0,8,8"/>
                                <Button Content="Hip-Hop" Tag="hip hop" Click="GenreButton_Click" Margin="0,0,8,8"/>
                                <Button Content="Jazz" Tag="jazz" Click="GenreButton_Click" Margin="0,0,8,8"/>
                                <Button Content="News" Tag="news" Click="GenreButton_Click" Margin="0,0,8,8"/>
                                <Button Content="Rock" Tag="rock" Click="GenreButton_Click" Margin="0,0,8,8"/>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <ListView x:Name="SearchResultsList" Grid.Row="2" Padding="20,0,20,20" AutomationProperties.Name="Search results"
                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}" IsItemClickEnabled="True"
                              ItemClick="StationList_ItemClick" SelectionMode="None" Visibility="Collapsed">
                        <ListView.ItemTemplate><DataTemplate x:DataType="models:RadioStation"><local:StationRowControl Station="{x:Bind}" FavoriteRequested="StationRow_FavoriteRequested"/></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <Grid x:Name="FavoritesView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Padding="28,20,28,12" Spacing="4">
                        <TextBlock Text="Favorites" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock Text="Your stations and listening history" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Padding="20,8,20,28" Spacing="22">
                            <StackPanel x:Name="FavoritesSection" Spacing="10">
                                <TextBlock Text="Favorites" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="8,0"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Favorites, Mode=OneWay}" IsItemClickEnabled="True"
                                          ItemClick="StationList_ItemClick" SelectionMode="None">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="models:RadioStation"><local:StationRowControl Station="{x:Bind}" FavoriteRequested="StationRow_FavoriteRequested"/></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="HistorySection" Spacing="10">
                                <TextBlock Text="Recently Played" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="8,0"/>
                                <ListView ItemsSource="{x:Bind ViewModel.Recents, Mode=OneWay}" IsItemClickEnabled="True"
                                          ItemClick="StationList_ItemClick" SelectionMode="None">
                                    <ListView.ItemTemplate><DataTemplate x:DataType="models:RadioStation"><local:StationRowControl Station="{x:Bind}" FavoriteRequested="StationRow_FavoriteRequested"/></DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="TopTracksSection" Spacing="10" Visibility="Collapsed">
                                <Grid Margin="8,0">
                                    <TextBlock Text="Top Tracks" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="TopTracksTimeframeBox" HorizontalAlignment="Right"
                                              AutomationProperties.Name="Top tracks timeframe" SelectionChanged="TopTracksTimeframeBox_SelectionChanged">
                                        <ComboBoxItem Content="This Week" IsSelected="True"/>
                                        <ComboBoxItem Content="This Month"/>
                                        <ComboBoxItem Content="All Time"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="TopTracksEmpty" Text="No tracks with both title and artist in this timeframe."
                                           Margin="12,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ListView x:Name="TopTracksList" ItemsSource="{x:Bind ViewModel.TopTracks, Mode=OneWay}"
                                          SelectionMode="None" AutomationProperties.Name="Top tracks">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:TopTrack">
                                            <Grid Padding="12,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <local:StationArtworkControl ArtworkUrl="{Binding ArtworkUrl}" FallbackArtworkUrl="{Binding StationArtworkUrl}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="HeardTracksSection" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="Recently Heard" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="8,0"/>
                                <ListView ItemsSource="{x:Bind ViewModel.HeardTracks, Mode=OneWay}" SelectionMode="None"
                                          AutomationProperties.Name="Recently heard tracks">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:HeardTrack">
                                            <StackPanel Padding="12,8" Spacing="2">
                                                <TextBlock Text="{x:Bind Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind Details}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                            <StackPanel x:Name="EmptyLibraryView" HorizontalAlignment="Center" Spacing="10" Padding="0,64" Visibility="Collapsed">
                                <FontIcon Glyph="&#xEB51;" FontSize="40" Opacity="0.55"/>
                                <TextBlock Text="No Favorites Yet" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Favorite and recently played stations appear here." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="SettingsView" Visibility="Collapsed" Padding="28,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="18" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock Text="Privacy" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <InfoBar Title="Setting not saved" Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind Settings.HasError, Mode=OneWay}"
                                 Message="{x:Bind Settings.ErrorMessage, Mode=OneWay}"/>
                        <toolkit:SettingsCard Header="Report plays to Radio Browser"
                                              Description="Sends the station ID when you start or resume a directory station. Pausing and automatic reconnect do not send a report.">
                            <ToggleSwitch x:Name="PlayReportingSwitch" AutomationProperties.Name="Report plays to Radio Browser"
                                          IsOn="{x:Bind Settings.IsPlayReportingEnabled, Mode=OneWay}"
                                          IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}"
                                          OnContent="On" OffContent="Off" Toggled="PlayReportingSwitch_Toggled"/>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Show album artwork for live tracks"
                                              Description="Sends recognized artist and title to Apple's iTunes Search API. Station artwork remains the fallback.">
                            <ToggleSwitch x:Name="AlbumArtworkSwitch" AutomationProperties.Name="Show album artwork for live tracks"
                                          IsOn="{x:Bind Settings.IsAlbumArtworkEnabled, Mode=OneWay}"
                                          IsEnabled="{x:Bind Settings.CanEdit, Mode=OneWay}"
                                          OnContent="On" OffContent="Off" Toggled="AlbumArtworkSwitch_Toggled"/>
                        </toolkit:SettingsCard>
                        <TextBlock Text="About" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Shoutkit for Windows · Native ARM64 preview"/>
                        <TextBlock Text="Favorites and recent stations are saved on this device. Station listings come from Radio Browser."
                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <HyperlinkButton Content="Radio Browser directory" NavigateUri="https://www.radio-browser.info/" Padding="0"/>
                        <toolkit:SettingsCard Header="Software licenses" Description="Application and dependency notices"
                                              IsClickEnabled="True" Click="SoftwareLicenses_Click"
                                              AutomationProperties.Name="View software licenses"/>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ProgressRing x:Name="LoadingRing" Width="42" Height="42" IsActive="False" Visibility="Collapsed"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Informational" AutomationProperties.LiveSetting="Polite"
                         HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16"/>
            </Grid>
        </NavigationView>
        <Grid x:Name="NowPlayingView" Grid.Row="1" Visibility="Collapsed" KeyDown="NowPlayingView_KeyDown"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <local:StationArtworkControl x:Name="AmbientArtwork" Opacity="0.10" IsHitTestVisible="False"/>
            <Border x:Name="AmbientTint" IsHitTestVisible="False" Opacity="0.22"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="520" HorizontalAlignment="Center"
                        Padding="24" Spacing="18">
                <Button x:Name="CloseNowPlayingButton" Content="Back to browsing" Click="CloseNowPlaying_Click" HorizontalAlignment="Left"
                        AutomationProperties.Name="Close Now Playing"/>
                <Border Width="280" Height="280" CornerRadius="18" HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <local:StationArtworkControl x:Name="HeroArtwork"/>
                </Border>
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Style="{ThemeResource TitleLargeTextBlockStyle}"
                               TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock x:Name="HeroSubtitle" Style="{ThemeResource BodyTextBlockStyle}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button Click="PlayPauseButton_Click" Width="52" Height="52" CornerRadius="26"
                            Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Play or pause">
                        <FontIcon x:Name="HeroPlayPauseIcon" Glyph="&#xE768;"/>
                    </Button>
                    <Button Click="FavoriteNowPlayingButton_Click" Width="52" Height="52"
                            AutomationProperties.Name="Toggle favorite" ToolTipService.ToolTip="Toggle favorite">
                        <FontIcon x:Name="HeroFavoriteIcon" Glyph="&#xEB51;"/>
                    </Button>
                    <Button Click="StopButton_Click" Width="52" Height="52"
                            AutomationProperties.Name="Stop playback" ToolTipService.ToolTip="Stop">
                        <FontIcon Glyph="&#xE71A;"/>
                    </Button>
                </StackPanel>
                <HyperlinkButton x:Name="HeroAppleMusicLink" Content="Open in Apple Music"
                                 Visibility="Collapsed" HorizontalAlignment="Center"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="MiniPlayer" Grid.Row="2" Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0" Padding="16,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="OpenNowPlayingButton" Click="OpenNowPlaying_Click" Width="48" Height="48" Padding="0" BorderThickness="0"
                    AutomationProperties.Name="Open Now Playing" ToolTipService.ToolTip="Open Now Playing">
                <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <local:StationArtworkControl x:Name="NowPlayingArtwork"/>
                </Border>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="NowPlayingTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="NowPlayingSubtitle" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                <HyperlinkButton x:Name="AppleMusicLink" Content="Open in Apple Music" Visibility="Collapsed"
                                 Padding="0" HorizontalAlignment="Left"/>
            </StackPanel>
            <Button x:Name="FavoriteNowPlayingButton" Grid.Column="2" Click="FavoriteNowPlayingButton_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Add to favorites"
                    ToolTipService.ToolTip="Add to Favorites"><FontIcon x:Name="FavoriteNowPlayingIcon" Glyph="&#xEB51;"/></Button>
            <Button x:Name="PlayPauseButton" Grid.Column="3" Click="PlayPauseButton_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Play"
                    Width="42" Height="42" Padding="0" CornerRadius="21" ToolTipService.ToolTip="Play or pause">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;"/>
            </Button>
            <Button x:Name="SleepTimerButton" Grid.Column="4" Content="Sleep" Margin="8,0,0,0"
                    AutomationProperties.Name="Sleep timer" ToolTipService.ToolTip="Set a sleep timer">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="15 minutes" Tag="15" Click="SleepTimerDuration_Click"/>
                        <MenuFlyoutItem Text="30 minutes" Tag="30" Click="SleepTimerDuration_Click"/>
                        <MenuFlyoutItem Text="45 minutes" Tag="45" Click="SleepTimerDuration_Click"/>
                        <MenuFlyoutItem Text="60 minutes" Tag="60" Click="SleepTimerDuration_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="CancelSleepTimerItem" Text="Cancel sleep timer" IsEnabled="False"
                                        Click="CancelSleepTimer_Click"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="5" Click="StopButton_Click" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Stop playback"
                    ToolTipService.ToolTip="Stop"><FontIcon Glyph="&#xE71A;"/></Button>
        </Grid>
    </Grid>
</Window>
