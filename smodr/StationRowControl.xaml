<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="smodr.StationRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:smodr"
             xmlns:models="using:smodr.Models">
    <Grid Padding="10" ColumnSpacing="14" MinHeight="68" AutomationProperties.Name="{x:Bind Station.Name, Mode=OneWay}">
        <Grid.ContextFlyout>
            <MenuFlyout><MenuFlyoutItem Text="Toggle Favorite" Click="FavoriteMenuItem_Click"/></MenuFlyout>
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
        <Border Width="52" Height="52" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <local:StationArtworkControl ArtworkUrl="{x:Bind Station.ArtworkUrl, Mode=OneWay}"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind Station.Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind Station.Details, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="2" Width="40" Height="40" CornerRadius="20"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE768;" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
