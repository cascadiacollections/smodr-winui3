<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>smodr</RootNamespace>
    <LangVersion>14.0</LangVersion>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cascadiacollections/smodr-winui3</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Authors>Cascadia Collections</Authors>
    <Description>Reusable radio Radio primitives extracted from Shoutkit Windows.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="Cascadia.Radio.Services" /><InternalsVisibleTo Include="smodr.RadioCore" /></ItemGroup>
  <ItemGroup><None Include="README.md" Pack="true" PackagePath="/" /></ItemGroup>
</Project>
