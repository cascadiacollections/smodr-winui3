<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RadioPackageVersion Condition="'$(RadioPackageVersion)' == ''">0.1.0</RadioPackageVersion>
    <!-- Packages are rebuilt locally with the same draft version on each platform. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Cascadia.RadioBrowser" VersionOverride="$(RadioPackageVersion)" /></ItemGroup>
</Project>
