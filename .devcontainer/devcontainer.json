{
  "name": "Shoutkit Windows — .NET 11 RC editing and RadioCore",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "target": "development"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "dotnet.defaultSolution": "portable/Radio.Portable.slnx",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        "files.exclude": {
          "**/bin": true,
          "**/obj": true,
          "**/.vs": true
        },
        "files.watcherExclude": {
          "**/bin/**": true,
          "**/obj/**": true,
          "**/.vs/**": true
        },
        "csharp.semanticHighlighting.enabled": true,
        "git.autofetch": true
      },
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "editorconfig.editorconfig",
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens"
      ]
    }
  },

  "forwardPorts": [],

  "onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.nuget/packages /var/tmp/shoutkit-radio-artifacts",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "updateContentCommand": "bash .devcontainer/prewarm.sh",
  "mounts": [
    "source=shoutkit-radio-nuget-${devcontainerId},target=/home/vscode/.nuget/packages,type=volume",
    "source=shoutkit-radio-artifacts-${devcontainerId},target=/var/tmp/shoutkit-radio-artifacts,type=volume"
  ],

  "remoteUser": "vscode",

  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "DOTNET_NOLOGO": "1",
    "RADIO_ARTIFACTS_DIR": "/var/tmp/shoutkit-radio-artifacts",
    "RADIO_NUGET_AUDIT": "false"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  }
}
