<Project>
  <PropertyGroup>
    <!-- Language and compiler settings -->
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Deterministic and reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Version stamping -->
    <VersionPrefix>1.0.0</VersionPrefix>

    <!-- Roslyn code-quality analyzers (built into .NET SDK, no NuGet needed) -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Enforce .editorconfig IDE* code-style rules during build, not just in IDE -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
    <!-- Opt-in CI/local analysis reports, one per project (never a shared ErrorLog). -->
    <ErrorLog Condition="'$(RadioAnalysisOutputDirectory)' != ''">$(RadioAnalysisOutputDirectory)/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>

    <!-- Required for IDE0005 (remove unnecessary usings) to work during build -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Explicit opt-in for the isolated experimental SDK comparison only. -->
    <NoWarn Condition="'$(EnableExperimentalWinUI)' == 'true'">$(NoWarn);CS8305</NoWarn>

    <!-- Generate packages.lock.json for deterministic restores -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
