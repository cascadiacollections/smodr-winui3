{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Shoutkit Windows (ARM64)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: ARM64 (Windows)",
      "program": "${workspaceFolder}/smodr/bin/ARM64/Debug/net11.0-windows10.0.22621.0/smodr.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Shoutkit Windows (x64)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: x64 (Windows)",
      "program": "${workspaceFolder}/smodr/bin/x64/Debug/net11.0-windows10.0.22621.0/smodr.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "Attach to running Shoutkit",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
